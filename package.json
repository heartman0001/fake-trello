{
  "name": "fake-trello",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade real-time Kanban board application",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "pnpm --filter fake-trello-web test:e2e"
  },
  "devDependencies": {
    "@prisma/client": "^5.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.0",
    "bcrypt": "^5.1.1",
    "prisma": "^5.7.0",
    "ts-node": "^10.9.2",
    "turbo": "^1.11.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.14.0",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
